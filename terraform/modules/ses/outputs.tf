output "domain_identity_arn" {
  description = "ARN of the SES domain identity"
  value       = aws_ses_domain_identity.this.arn
}

output "dkim_tokens" {
  description = "DKIM tokens generated by AWS SES"
  value       = aws_ses_domain_dkim.this.dkim_tokens
}

output "cloudflare_dkim_cname_records" {
  description = "Add these 3 CNAME records in Cloudflare DNS with Proxy status = DNS only (grey cloud)"
  value = [
    for token in aws_ses_domain_dkim.this.dkim_tokens : {
      type    = "CNAME"
      name    = "${token}._domainkey.${var.domain}"
      target  = "${token}.dkim.amazonses.com"
      proxied = false
    }
  ]
}
